{
  "name": "@codelitdev/platform-conformance",
  "version": "0.1.0-alpha.0",
  "description": "Shared HTTP conformance suites for CodeLit Platform products",
  "author": "CodeLit",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test --timeout 60000 src",
    "test:packed": "bun scripts/packed-consumer.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint ."
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "peerDependencies": {
    "@codelitdev/platform": ">=0.1.0-alpha.0"
  },
  "devDependencies": {
    "@codelitdev/platform": "workspace:*",
    "@types/bun": "^1.4.1",
    "@types/node": "^22.14.1",
    "typescript": "^5.9.3"
  }
}
