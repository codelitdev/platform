{
  "name": "@codelitdev/platform-cli",
  "version": "0.1.0-alpha.1",
  "description": "Create, check, and sync CodeLit Platform products",
  "author": "CodeLit",
  "type": "module",
  "license": "MIT",
  "bin": {
    "codelit-platform": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun -e \"import('node:fs').then(fs=>{fs.copyFileSync('src/preset.json','dist/preset.json');fs.rmSync('template',{recursive:true,force:true});fs.cpSync('../../templates/saas-product','template',{recursive:true})})\"",
    "test": "bun test --timeout 60000 src --path-ignore-patterns=**/template/**",
    "test:packed": "bun scripts/packed-consumer.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint ."
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^22.14.1",
    "typescript": "^5.9.3"
  }
}
