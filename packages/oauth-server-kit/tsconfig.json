{
    "exclude": ["dist", "build", "node_modules"],
    "compilerOptions": {
        "outDir": "./dist",
        "lib": ["es2017", "dom"],
        "strict": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2017",
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": { "@/*": ["src/*"] },
        "allowSyntheticDefaultImports": true
    },
    "include": ["src/**/*"]
}
