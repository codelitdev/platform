{
  "name": "@codelitdev/mcp-server-kit",
  "version": "0.4.0",
  "description": "MCP transport, session, auth hooks, and error mapping for CodeLit products",
  "author": "CodeLit",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelitdev/platform.git",
    "directory": "packages/mcp-server-kit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test --timeout 60000 src",
    "test:packed": "bun scripts/packed-consumer.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint .",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@codelitdev/platform": ">=0.4.0"
  },
  "devDependencies": {
    "@codelitdev/platform": "workspace:*",
    "@types/bun": "^1.4.1",
    "@types/node": "^22.14.1",
    "typescript": "^5.9.3"
  }
}
