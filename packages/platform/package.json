{
  "name": "@codelitdev/platform",
  "version": "0.2.0",
  "description": "Composition kernel for CodeLit Platform products",
  "author": "CodeLit",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelitdev/platform.git",
    "directory": "packages/platform"
  },
  "homepage": "https://github.com/codelitdev/platform/tree/main/packages/platform#readme",
  "bugs": {
    "url": "https://github.com/codelitdev/platform/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test --timeout 60000 src",
    "test:watch": "bun test --watch --timeout 60000 src",
    "test:packed": "bun scripts/packed-consumer.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint .",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^22.14.1",
    "typescript": "^5.9.3"
  }
}
