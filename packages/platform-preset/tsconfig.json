{
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["**/*.test.ts"]
}
