{
  "name": "@codelitdev/platform-preset",
  "version": "0.1.0",
  "description": "Compatibility bill of materials for CodeLit Platform packages",
  "author": "CodeLit",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun -e \"import('node:fs').then(fs=>fs.copyFileSync('src/manifest.json','dist/manifest.json'))\"",
    "test": "bun test --timeout 60000 src",
    "test:packed": "bun scripts/packed-consumer.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint ."
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^22.14.1",
    "typescript": "^5.9.3"
  }
}
