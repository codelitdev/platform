{
  "name": "@reference-product/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "generate:billing": "codelit-billing generate --config billing.config.ts",
    "generate:auth-schema": "node scripts/generate-auth-schema.mjs",
    "check:billing-schema": "codelit-billing generate --check --config billing.config.ts",
    "check:auth-schema": "node scripts/generate-auth-schema.mjs --check",
    "check:drift": "pnpm check:billing-schema && pnpm check:auth-schema",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.mjs",
    "pretest": "pnpm check:auth-schema"
  },
  "dependencies": {
    "@better-auth/core": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@codelitdev/billing": "workspace:*",
    "@codelitdev/mcp-server-kit": "workspace:*",
    "@codelitdev/oauth-server-kit": "workspace:*",
    "@codelitdev/observability": "workspace:*",
    "@codelitdev/platform": "workspace:*",
    "@codelitdev/platform-conformance": "workspace:*",
    "@reference-product/api-contract": "workspace:*",
    "@ts-rest/express": "3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@types/pg": "^8.23.1",
    "better-call": "1.4.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.1",
    "drizzle-kit": "0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
