{
  "name": "__PRODUCT_SLUG__",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.4"
  },
  "scripts": {
    "lint": "bun run --workspaces --if-present lint",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false .",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "build": "bun run --workspaces --if-present build",
    "migrate": "bun apps/api/scripts/migrate.mjs",
    "generate:openapi": "bun run --filter '*/api' generate:openapi",
    "check:openapi": "bun run --filter '*/api' check:openapi"
  }
}
