{
  "name": "@__PRODUCT_SLUG__/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 60000 src",
    "test:conformance": "bun test --timeout 60000 src --test-name-pattern \"platform conformance\"",
    "lint": "biome lint .",
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "generate:billing": "codelit-billing generate --config billing.config.ts",
    "generate:auth-schema": "bun scripts/generate-auth-schema.mjs",
    "check:billing-schema": "codelit-billing generate --check --config billing.config.ts",
    "check:auth-schema": "bun scripts/generate-auth-schema.mjs --check",
    "check:drift": "bun run check:billing-schema && bun run check:auth-schema",
    "migrate": "bun scripts/migrate.mjs",
    "pretest": "bun run check:auth-schema"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@codelitdev/billing": "workspace:*",
    "@codelitdev/oauth-server-kit": "workspace:*",
    "@codelitdev/mcp-server-kit": "workspace:*",
    "@codelitdev/platform-conformance": "workspace:*",
    "@codelitdev/observability": "workspace:*",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@ts-rest/express": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "@codelitdev/platform": "workspace:*",
    "@__PRODUCT_SLUG__/api-contract": "workspace:*",
    "@types/pg": "8.23.1",
    "better-call": "1.4.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.2",
    "express": "4.21.2",
    "pg": "8.23.0",
    "pino": "9.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "@types/bun": "1.4.1"
  }
}
