# API runtime
PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/__PRODUCT_SLUG__

# Generate local random values; AUTH_SECRET must be at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
API_KEY_PEPPER=replace-with-a-random-pepper-at-least-32-characters
SEED=1

# Optional observability integrations.
LOG_LEVEL=info
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# OTLP_LOGS_ENDPOINT=
# OTLP_LOGS_AUTHORIZATION=
